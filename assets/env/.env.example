# Copy this file to assets/env/.env and fill in your own values.
# assets/env/.env is git-ignored — NEVER commit real keys or secrets.
# These are PUBLIC-facing keys only (anon key, public API keys). The service
# role key and Xendit secret key must ONLY live in Supabase edge-function env.
#
# For jireta.vercel.app (Aug 2026):
# - SUPABASE_URL must be your real project, e.g. https://lcelzrvpqwlbeccrwpkp.supabase.co
# - EDGE_FUNCTIONS_URL defaults to $SUPABASE_URL/functions/v1 if unset in Vercel.
# - On Vercel, set these in Project Settings → Environment Variables, then redeploy.
#   If you leave the placeholder your-project.supabase.co the app will show
#   a permanent "No Internet Connection" (probe DNS fails) — see scripts/vercel-build.sh.
#
# Supabase Edge Functions CORS:
# - Set CORS_ALLOWED_ORIGINS to include every web origin that calls the API:
#   supabase secrets set CORS_ALLOWED_ORIGINS=https://jireta.vercel.app,https://lending-jet-five.vercel.app,https://app.jiretaloanscorp.com
#   Otherwise the browser blocks responses and Dio throws unknown → "Unable to reach server (CORS)".

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
EDGE_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1
GOOGLE_MAPS_API_KEY=your-google-maps-key
XENDIT_PUBLIC_KEY=xendit_public_xxx
APP_ENV=development