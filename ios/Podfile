# ios/Podfile
# ─────────────────────────────────────────────────────────────────────────────
# iOS 15.5 ang pinakamababang target — HINDI 15.0:
#   • google_mlkit_face_detection (GoogleMLKit/FaceDetection 9.x) ay
#     `s.platform = :ios, '15.5'` — kapag 15.0 ang Runner, pumapalya ang
#     `pod install` ("The platform of the target `Runner` (iOS 15.0) is not
#     compatible with `google_mlkit_face_detection` which requires iOS 15.5").
#   • firebase_core / firebase_messaging (Firebase Apple SDK 12) ay 15.0,
#     kaya sakop pa rin ng 15.5.
# Kapareho ito ng IPHONEOS_DEPLOYMENT_TARGET sa Runner.xcodeproj at ng
# komento sa pubspec.yaml. `flutter build ios` ay gumagawa ng sariling
# Podfile kapag wala ito — doon 15.0 ang default at doon nangyayari ang
# mismatch, kaya naka-commit ito.
# ─────────────────────────────────────────────────────────────────────────────

platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Itinuturo ito ng google_mlkit_face_detection README: 32-bit (armv7) ang
# tanging architecture na HINDI sinusuportahan ng ML Kit, kaya kailangang
# i-exclude para tumakbo ang `flutter build ios` / `flutter build ipa`.
$iOSVersion = '15.5'

post_install do |installer|
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=*]'] = 'armv7'
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # I-align ang deployment target ng bawat pod sa 15.5 para hindi na
    # mag-warning/mag-fail ang pod targets na mas mababa ang naka-set.
    target.build_configurations.each do |config|
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] || '0'
      if Gem::Version.new($iOSVersion) > Gem::Version.new(current)
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
      end
    end
  end
end
