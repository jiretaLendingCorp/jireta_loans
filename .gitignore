# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment / secrets (never commit real keys)
assets/env/.env
*.env
!.env.example

# Android signing (keystore + key.properties). Ginagawa ito ng
# .github/workflows/android-apk-release.yml mula sa GitHub secrets.
android/key.properties
android/upload-keystore.jks
*.jks
*.keystore

# Release APKs (~141 MB — lampas sa 100 MB na file limit ng GitHub, at sa
# 50 MB na file limit ng Supabase Storage free plan). Naka-host ang APK sa
# GitHub Releases — tingnan ang web/downloads/README.md.
# Tumatama ito sa LAHAT ng folder (root, web/downloads/, atbp.) — ang
# pattern na may leading slash lang ang naka-pin sa isang folder.
*.apk
